# --- Basis data PostgreSQL (Drizzle) -------------------------------------------------
# Di Netlify koneksi tersedia otomatis lewat NETLIFY_DB_URL.
# Di host lain (mis. Vercel) setel DATABASE_URL dengan connection string yang sama.
# DATABASE_URL=postgres://user:password@host:6543/database?sslmode=require
# Supabase: koneksi langsung db.<ref>.supabase.co hanya IPv6 dan tidak bisa
# dijangkau Vercel. Pakai Transaction pooler (IPv4, port 6543) dari
# Supabase -> Connect agar koneksi serverless tidak cepat habis:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<wilayah>.pooler.supabase.com:6543/postgres
# (sslmode=require + uselibpqcompat=true ditambahkan aplikasi sendiri untuk host Supabase)
# Opsional: paksa driver Neon (hanya untuk basis data Neon, mis. Netlify Database).
# NETLIFY_DB_DRIVER=serverless

# --- Supabase ------------------------------------------------------------------------
# Dipakai klien Supabase (peramban + server) dan penyegaran sesi di src/proxy.ts.
# Keduanya kunci publik, jadi boleh ada di bundel klien. Jangan pernah menaruh
# service role / secret key di variabel NEXT_PUBLIC_ maupun di berkas yang di-commit.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Proyek lama memakai nama ini sebagai ganti kunci publishable.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Ulasan komunitas -----------------------------------------------------------------
# Ulasan kiriman pengunjung disimpan di PostgreSQL (tabel cms_reviews) dan
# dibagikan ke semua pengunjung setelah disetujui editor. Kiriman boleh anonim
# (akun hanya menautkan ulasan ke pengirimnya), dan dijaga dengan empat cara: token perangkat anonim
# (otomatis, tanpa env), pembatasan laju per IP (otomatis), honeypot (otomatis),
# dan Cloudflare Turnstile (opsional, lihat di bawah).
#
# Cloudflare Turnstile — opsional. Isi KEDUA kunci agar penyaring ini aktif;
# kalau hanya salah satu yang diisi, Turnstile dimatikan supaya formulir ulasan
# tidak pernah macet. Kunci situs boleh tampil di peramban, kunci rahasia tidak.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
#
# Opsional: ubah batas kiriman tanpa mengubah kode. Bawaannya 1 ulasan per resep
# per perangkat per 24 jam, 8 ulasan per perangkat per hari, dan 24 per IP per
# hari. Nilai 0 mematikan batas yang bersangkutan.
# REVIEW_PER_RECIPE_PER_DEVICE_LIMIT=1
# REVIEW_PER_DEVICE_DAILY_LIMIT=8
# REVIEW_IP_DAILY_LIMIT=24

# --- Situs & admin -------------------------------------------------------------------
# Alamat kanonik untuk metadata, sitemap, dan structured data.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Kata sandi dashboard admin. Wajib diisi agar /login bisa dipakai.
# Nilai ini juga jadi kunci cadangan: jangan sampai kosong, dan biarkan terpasang
# walau kata sandi sudah diganti dari dashboard (Studio -> Keamanan), supaya Anda
# tidak terkunci di luar dashboard bila lupa.
ADMIN_PASSWORD=replace-with-a-strong-password
# Opsional: bila kosong, ADMIN_PASSWORD juga dipakai untuk menandatangani sesi.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
