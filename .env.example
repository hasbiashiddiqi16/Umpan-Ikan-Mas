# Hosted PostgreSQL connection string used by the server-side Drizzle client.

# Set the canonical production origin for metadata, sitemap, and structured data.
# Netlify's built-in URL is used automatically when this value is omitted.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# Set the requested admin password in your local .env.local or Netlify environment.
ADMIN_PASSWORD=replace-with-a-strong-password
# Optional: if omitted, ADMIN_PASSWORD is also used to sign the session cookie.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
